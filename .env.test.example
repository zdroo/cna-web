# Copy this file to .env.test and fill in your values before running Playwright tests.
# Tests that only need a regular user: 1, 2, 4, 5, 6a, 8
# Tests that need an Admin/Seller account: 3, 6b, 7

NEXT_PUBLIC_API_URL=https://localhost:44381

# Regular confirmed user
TEST_EMAIL=your-user@example.com
TEST_PASS=YourPassword123!

# Admin or Seller account (can be the same as above if the user is Admin)
TEST_ADMIN_EMAIL=your-admin@example.com
TEST_ADMIN_PASS=YourAdminPassword123!
